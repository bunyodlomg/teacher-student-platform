# MongoDB connection
MONGODB_URI="mongodb://127.0.0.1:27017/cambridge-learn"

# Auth — generate a long random string for production
JWT_SECRET="change-me-to-a-long-random-secret"

# Bootstrap admin (created by `npm run db:seed` if no admin exists)
ADMIN_NAME="Administrator"
ADMIN_EMAIL="admin@cambridge.uz"
ADMIN_PASSWORD="change-this-password"

# Server port
PORT=3000

# Telegram bot (ixtiyoriy) — ota-onalarga test natijalarini yuborish uchun.
# BotFather'da (@BotFather) yangi bot yaratib, tokenni shu yerga qo'ying.
# Bo'sh qoldirilsa bot o'chiq turadi, ilova baribir normal ishlaydi.
TELEGRAM_BOT_TOKEN=""
